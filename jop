    <script>
        // Modal logic
        const modal = document.getElementById('contactModal');
        const backdrop = document.getElementById('modalBackdrop');
        const content = document.getElementById('modalContent');

        function openModal() {
            // Enable pointer events
            modal.classList.remove('pointer-events-none');
            backdrop.classList.remove('pointer-events-none');
            content.classList.remove('pointer-events-none');
            
            // Prevent body scroll
            document.body.classList.add('modal-open');
            
            // Trigger animations (slight delay for render)
            setTimeout(() => {
                backdrop.classList.remove('opacity-0');
                backdrop.classList.add('opacity-100');
                
                content.classList.remove('translate-y-full');
                content.classList.add('translate-y-0');
            }, 10);
        }

        function closeModal() {
            // Revert animations
            backdrop.classList.remove('opacity-100');
            backdrop.classList.add('opacity-0');
            
            content.classList.remove('translate-y-0');
            content.classList.add('translate-y-full');
            
            // Wait for transition to finish before hiding elements and restoring scroll
            setTimeout(() => {
                modal.classList.add('pointer-events-none');
                backdrop.classList.add('pointer-events-none');
                content.classList.add('pointer-events-none');
                document.body.classList.remove('modal-open');
            }, 300); // Matches the duration-300 class in Tailwind
        }

        // Close modal on Escape key press
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
                closeModal();
            }
        });
    </script>
