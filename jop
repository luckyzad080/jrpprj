<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pinkjulieland - Welcome to my shop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Mitr:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Mitr', 'sans-serif'],
                        heading: ['Fredoka', 'sans-serif'],
                    },
                    colors: {
                        theme: {
                            bg: '#FAFAFC',
                            card: '#FFFFFF',
                            textDark: '#332E3A',
                            textMuted: '#6B6670',
                            noteBg: '#F3F4F6',
                            btnBg: '#F6F3F9',
                            btnHover: '#EBE5F0',
                            accent: '#FFB6C1',
                            purpleSoft: '#E8D1EE',
                        }
                    },
                    boxShadow: {
                        'soft': '0 4px 20px rgba(0, 0, 0, 0.03)',
                        'float': '0 10px 30px rgba(0, 0, 0, 0.06)',
                        'glow': '0 0 15px rgba(253, 176, 192, 0.4)',
                    },
                    animation: {
                        blob: "blob 7s infinite",
                        float: "float 4s ease-in-out infinite",
                        floatSlow: "float 6s ease-in-out infinite",
                        pulseSoft: "pulseSoft 3s ease-in-out infinite",
                    },
                    keyframes: {
                        blob: {
                            "0%": { transform: "translate(0px, 0px) scale(1)" },
                            "33%": { transform: "translate(30px, -50px) scale(1.1)" },
                            "66%": { transform: "translate(-20px, 20px) scale(0.9)" },
                            "100%": { transform: "translate(0px, 0px) scale(1)" },
                        },
                        float: {
                            "0%, 100%": { transform: "translateY(0)" },
                            "50%": { transform: "translateY(-8px)" },
                        },
                        pulseSoft: {
                            "0%, 100%": { opacity: 1, transform: "scale(1)" },
                            "50%": { opacity: 0.7, transform: "scale(0.95)" },
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            background-color: #FAFAFC;
            color: #332E3A;
            -webkit-tap-highlight-color: transparent;
        }
        ::-webkit-scrollbar {
            width: 0px;
            background: transparent;
        }
        .modal-open {
            overflow: hidden;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .animation-delay-2000 { animation-delay: 2s; }
        .animation-delay-4000 { animation-delay: 4s; }
        
        /* Glass card effect for sections */
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        /* Modal animations */
        .modal-overlay-enter { opacity: 0; }
        .modal-overlay-enter-active { opacity: 1; transition: opacity 300ms ease-out; }
        .modal-overlay-exit { opacity: 1; }
        .modal-overlay-exit-active { opacity: 0; transition: opacity 300ms ease-in; }
        
        .modal-content-enter { transform: translateY(100%); }
        .modal-content-enter-active { transform: translateY(0); transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1); }
        .modal-content-exit { transform: translateY(0); }
        .modal-content-exit-active { transform: translateY(100%); transition: transform 250ms ease-in; }
    </style>
</head>
